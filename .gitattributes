# Бинарные ресурсы: никакой нормализации переводов строк
resources/bin/** -text
resources/bin-linux/** -text
resources/bin-windows/** -text
resources/system/*.sqlite3 -text
resources/windivert.filter/*.txt text eol=crlf
resources/lua/** text eol=crlf
resources/lists/** text eol=crlf
resources/presets/** text eol=crlf

# Подписанный список выпуска: подпись считается по байтам файла, поэтому
# переводы строк обязаны быть LF на любой системе — иначе на Windows
# (autocrlf) подпись перестаёт сходиться и канонические байты не совпадают.
crates/primecore-manifest/tests/fixtures/** text eol=lf
