{
  "name": "primebypass-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Оболочка Electron для ядра primecore: та же Vite-сборка идёт и в Android (Capacitor).",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "vite build && electron .",
    "electron:start": "electron .",
    "assets": "electron scripts/brand-assets.cjs",
    "dist": "vite build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "author": "SpherePrime",
  "build": {
    "appId": "ru.sphereprime.primebypass",
    "productName": "PrimeBypass",
    "copyright": "© 2026 SpherePrime",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../target/release/primecore-server.exe",
        "to": "primecore-server.exe"
      },
      {
        "from": "../../resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!bin-linux/**"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "PrimeBypass-Setup-${version}.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": "PrimeBypassSetup"
    }
  }
}
